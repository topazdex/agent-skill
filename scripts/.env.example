# Topaz skill — local environment
#
# Copy to `.env` and fill in. Every RPC has a public default; override for production.
# PRIVATE_KEY is required for any write operation (swap, lp, lock, vote, claim, bribe, position).
# Analytics default to the public multichain Topaz API; subgraph URLs default to the Goldsky-hosted
# BNB endpoints. Override either only if you run a private mirror.

# Optional: BNB Chain JSON-RPC (default below). Replace with your own for production to
# avoid rate limits. Takes precedence over TOPAZ_RPC_56 when both are set.
# BSC_RPC_URL=https://bsc-rpc.publicnode.com

# Optional: backup RPC tried if BSC_RPC_URL fails.
# BSC_RPC_URL_FALLBACK=https://1rpc.io/bnb

# Optional per-chain RPCs for `--chain` / `chainId` (defaults: references/deployments.json).
# TOPAZ_RPC_4663=https://rpc.mainnet.chain.robinhood.com
# TOPAZ_RPC_8453=https://mainnet.base.org
# TOPAZ_RPC_1=https://ethereum-rpc.publicnode.com
# TOPAZ_RPC_5042=https://rpc.mainnet.arc.io

# Required for write operations. Hex string starting with 0x.
# DO NOT COMMIT THE REAL VALUE.
PRIVATE_KEY=

# Optional: public multichain Topaz API base (default baked into scripts/src/lib/topazApi.ts).
# Routes live under /v1; the OpenAPI contract is https://api.topazdex.com/openapi.json.
# TOPAZ_API_URL=https://api.topazdex.com

# Optional BNB subgraph overrides (defaults baked into scripts/src/lib/subgraph.ts).
SUBGRAPH_V2_URL=https://api.goldsky.com/api/public/project_cmgzljqwl006c5np2gnao4li4/subgraphs/topaz-v2/prod/gn
SUBGRAPH_V3_URL=https://api.goldsky.com/api/public/project_cmgzljqwl006c5np2gnao4li4/subgraphs/topaz-v3/prod/gn
SUBGRAPH_VE_URL=https://api.goldsky.com/api/public/project_cmgzljqwl006c5np2gnao4li4/subgraphs/topaz-ve/prod/gn

# Optional: DexScreener pair address for canonical TOPAZ price lookup.
# By default, scripts derive TOPAZ USD via v3 subgraph (Token.derivedETH * Bundle.ethPriceUSD).
# Set this to skip subgraph and query DexScreener directly.
# DEXSCREENER_TOPAZ_PAIR=

# Optional: legacy BNB Stats reports base (default baked into scripts/src/lib/statsApi.ts).
# Only the retained historical reports use this; current data comes from /v1 above.
# TOPAZ_STATS_API_URL=https://api.topazdex.com/api/stats
